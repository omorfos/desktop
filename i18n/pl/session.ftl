### Słowa powiadomień omorfos-session po polsku.
### Translated by a machine, and not yet read by someone who speaks Polish.

volume = Głośność
muted = Wyciszono
microphone-muted = Mikrofon wyciszony
microphone-on = Mikrofon włączony
brightness = Jasność

aeroplane-on = Tryb samolotowy włączony
aeroplane-off = Tryb samolotowy wyłączony
radio-off = Wyłączono: { $radio }
radio-on = Włączono: { $radio }
radio = { $kind ->
    [wlan] Wi-Fi
    [bluetooth] Bluetooth
    [uwb] UWB
    [wimax] WiMAX
    [wwan] Internet mobilny
    [gps] GPS
    [fm] Radio FM
    [nfc] NFC
   *[other] Radio
}

unlocked-title = Ekran nie został zablokowany przed uśpieniem
unlocked-body = Komputer zasnął, zanim program blokujący ekran zdążył go zablokować, więc obudził się odblokowany. Sprawdź, czy `locker` w config.yaml wskazuje program blokujący ekran i czy uruchamia się on szybko.
