### Słowa ekranu blokady po polsku.
### Translated by a machine, and not yet read by someone who speaks Polish.

sleep = Uśpij
restart = Uruchom ponownie
shut-down = Wyłącz
log-out = Wyloguj
cancel = Anuluj
restart-asked = Uruchomić ponownie? To, co niezapisane w otwartych programach, przepadnie.
shut-down-asked = Wyłączyć? To, co niezapisane w otwartych programach, przepadnie.
log-out-asked = Wylogować? To, co niezapisane w otwartych programach, przepadnie.

did-not-happen = { $act }: nie udało się. { $why }

kept-from = { $who } nie pozwala { $from ->
    [sleep] uśpić komputera
   *[off] wyłączyć komputera
}

wrong = Nieprawidłowe hasło

types = prosi o wpisanie czegoś, a wpisać można tylko hasło

touch-key = Dotknij klucza bezpieczeństwa

finger-place = Połóż palec na czytniku
finger-wrong = Nie rozpoznano odcisku palca
