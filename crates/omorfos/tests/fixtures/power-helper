#!/bin/sh
# Stands in for `omorfos-session` as the lock screen asks it, as
# `power-helper THERE WORDS...`, THERE being a directory of the test's own:
# `offered` says what THERE/offered says, and anything else is written to
# THERE/asked and done, once there is no THERE/hold, or refused with a
# reason if there is THERE/refuse.
there=$1
shift
if [ "$1" = offered ]; then
    cat "$there/offered" 2>/dev/null
    exit 0
fi
printf '%s\n' "$*" >> "$there/asked"
while [ -e "$there/hold" ]; do sleep 0.01; done
if [ -e "$there/refuse" ]; then
    printf 'omorfos-session: logind said no\n' >&2
    exit 1
fi
