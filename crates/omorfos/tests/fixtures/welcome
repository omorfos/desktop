#!/bin/sh
# Stands in for the welcome card where a test wants to see the compositor
# show it: it leaves a mark beside the session's socket, saying what it was
# started with, and stays open until it is told to close, or for a few
# seconds at most.
directory="$(dirname "$OMORFOS_SOCKET")"
printf '%s;' "$*" >> "$directory/welcome-opened"
tries=0
while [ ! -e "$directory/welcome-close" ] && [ "$tries" -lt 100 ]; do
  sleep 0.05
  tries=$((tries + 1))
done
rm -f "$directory/welcome-close"
