### The launcher's words, in English, which every other language falls back
### on a message at a time (ADR 79).

# Under the text field, when no program matches what is typed. $typed is
# what is typed.
nothing-matches = Nothing matches “{ $typed }”

# Under the answer to a sum typed, which Enter puts on the clipboard.
enter-copies = Enter copies the answer

# Over the best match of all, alone at the top, in the launcher's mode
# that finds everything.
launcher-top-hit = Top hit

# Over the programs found after the best match of all, in the launcher's
# mode that finds everything.
launcher-programs = Programs
