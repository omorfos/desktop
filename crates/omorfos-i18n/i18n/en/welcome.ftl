### The welcome card's words, in English, which every other language
### falls back on a message at a time (ADR 79).

title = Welcome to omorfos
# Under the mark, on the first step.
greeting = A few steps to make it yours. Each can be changed later, and Skip keeps everything as it is.

## The headings of the other steps.
keys = The keys that matter
scheme = Light or dark
wallpaper = Wallpaper
applications = What opens what

## What the keys that matter do, each after the keys themselves.
terminal = Open a terminal
launcher = Start anything by its name
menu = Open the menu
switcher = Switch between windows
# Super with C, X, V and Z, as Ctrl elsewhere.
copy-paste = Copy, cut, paste and undo, as Ctrl does elsewhere

## The schemes.
dark = Dark
light = Light
# Light by day and dark by night.
auto = With the day

## The kinds of thing, each before the application that opens it.
web = The web
files = Files
mail = Mail
pictures = Pictures
music = Music
video = Video
# In place of an application, where none is set.
none-set = None set
# Under the applications.
chosen-elsewhere = These are chosen by the system for now; Settings will let you change them.

## The buttons.
skip = Skip
back = Back
next = Next
finish = Finish

# Why a choice could not be saved, in English, as $why.
refused = config.yaml was left as it was: { $why }
