#!/bin/sh
# Stands in for WirePlumber's wpctl, and fails on anything it was not
# expected to be asked.
case "$*" in
"set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+" | "set-volume @DEFAULT_AUDIO_SINK@ 5%-" | \
"set-mute @DEFAULT_AUDIO_SINK@ toggle" | "set-mute @DEFAULT_AUDIO_SOURCE@ toggle") ;;
"get-volume @DEFAULT_AUDIO_SINK@") echo "Volume: 0.45" ;;
"get-volume @DEFAULT_AUDIO_SOURCE@") echo "Volume: 1.00" ;;
*) echo "asked what it was not expected to be: $*" >&2; exit 3 ;;
esac
