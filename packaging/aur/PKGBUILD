# Maintainer: Rafal Proszowski <foss@paroxp.org>
#
# The release workflow fills in pkgver and sha256sums and pushes this file
# to the AUR. See docs/RELEASING.md.

pkgname=omorfos
pkgver=0.1.0
pkgrel=1
pkgdesc='A lightweight Wayland compositor'
arch=('x86_64' 'aarch64')
url='https://github.com/omorfos/desktop'
license=('MIT' 'CC-BY-SA-4.0')
depends=('gcc-libs' 'glibc' 'libglvnd' 'libinput' 'libpipewire>=1.4' 'libxkbcommon' 'mesa' 'pam'
         'seatd' 'systemd-libs' 'ttf-font')
makedepends=('cargo' 'clang')
# How the lock screen asks PAM, the system's to change once installed.
backup=('etc/pam.d/omorfos-lock' 'etc/pam.d/omorfos-lock-fingerprint' 'etc/pam.d/omorfos-lock-key')
optdepends=('foot: the terminal started by the default key bindings'
            'xorg-xwayland: to run programs written for X11'
            'xdg-desktop-portal: so applications follow the look of the desktop and can ask for screenshots'
            'xdg-desktop-portal-gtk: to choose files, which omorfos leaves to it'
            'glib2: to wait at login for the portal backend of omorfos (gdbus)'
            'dbus: to tell D-Bus of the session (dbus-update-activation-environment)'
            'pipewire>=1.4: to share the screen in a browser or a call'
            'wireplumber: for the volume keys (wpctl)'
            'wl-clipboard: for an editor in a terminal, such as Neovim, to copy and paste')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "desktop-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "desktop-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p omorfos -p omorfos-hold -p omorfosctl -p omorfos-panel -p omorfos-launcher -p omorfos-notifications -p omorfos-screenshot -p omorfos-clipboard -p omorfos-recording -p omorfos-session -p omorfos-ask -p omorfos-wallpaper -p omorfos-lock -p xdg-desktop-portal-omorfos -p omorfos-brand
  # The icon and the wallpapers, drawn as omorfos is built.
  target/release/omorfos-brand target/release/share
}

package() {
  cd "desktop-$pkgver"
  install -Dm755 target/release/omorfos target/release/omorfos-hold target/release/omorfosctl target/release/omorfos-panel target/release/omorfos-launcher target/release/omorfos-notifications target/release/omorfos-screenshot target/release/omorfos-clipboard target/release/omorfos-recording target/release/omorfos-session target/release/omorfos-ask target/release/omorfos-pinentry target/release/omorfos-wallpaper target/release/omorfos-lock target/release/xdg-desktop-portal-omorfos -t "$pkgdir/usr/bin/"
  install -Dm644 LICENSE LICENSE-pictures -t "$pkgdir/usr/share/licenses/$pkgname/"
  cp -r target/release/share/icons target/release/share/backgrounds "$pkgdir/usr/share/"
  install -Dm644 README.md docs/CONFIGURATION.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 crates/omorfos-config/src/default.css "$pkgdir/usr/share/doc/$pkgname/theme.css"
  install -Dm644 schemas/*.json -t "$pkgdir/usr/share/$pkgname/schemas/"
  install -Dm644 packaging/omorfos.desktop -t "$pkgdir/usr/share/wayland-sessions/"
  install -Dm644 packaging/omorfos.portal -t "$pkgdir/usr/share/xdg-desktop-portal/portals/"
  install -Dm644 packaging/omorfos-portals.conf -t "$pkgdir/usr/share/xdg-desktop-portal/"
  install -Dm644 packaging/omorfos-session.target -t "$pkgdir/usr/lib/systemd/user/"
  install -Dm644 packaging/pam/omorfos-lock packaging/pam/omorfos-lock-fingerprint packaging/pam/omorfos-lock-key -t "$pkgdir/etc/pam.d/"
}
