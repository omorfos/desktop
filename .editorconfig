# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
max_line_length = 100

[*.{yaml,yml,toml,json,md}]
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

# Arch's own convention for what makes a package.
[{PKGBUILD,*.install}]
indent_size = 2

# Shell is indented as the rest is. shfmt reads this file, and the gates
# and CI hold every script to it; the hooks have no extension to be told
# by, so they are named by where they are.
[*.sh]
indent_size = 4
switch_case_indent = true

[.githooks/*]
indent_size = 4
switch_case_indent = true

# Generated; never reformat by hand.
[Cargo.lock]
indent_size = unset
trim_trailing_whitespace = unset
