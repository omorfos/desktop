# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
max_line_length = 100

[*.{yaml,yml,toml,json,md}]
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

[{PKGBUILD,*.install,*.sh,*.fish}]
indent_size = 2

# Generated; never reformat by hand.
[Cargo.lock]
indent_size = unset
trim_trailing_whitespace = unset
